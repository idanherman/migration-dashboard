# Deployment config for migration-test-system
# Copy to deploy.conf and set values. Override with CLI: -r REGISTRY -n NAMESPACE

# Required: image registry (e.g. for airgapped transfer)
REGISTRY=registry.example.com:5000

# Required: target namespace
NAMESPACE=migration-test-system

# Optional: image tag and name
IMAGE_TAG=v1.0.3
PEER_APP_IMAGE=applications/peer-app

# Optional: NodePort service name (used to read port)
NODE_PORT_SVC_NAME=migration-peer-nodeport

# Optional: expose NodePort svc via one shared Route; prints ROUTE_PROBE_URL for bastion (router health).
APPLY_ROUTE_PROBE=yes
# ROUTE_PROBE_SCHEME=https
# ROUTE_PROBE_NAME=migration-peer-route-probe

# Optional: create one LoadBalancer Service per node (migration-peer-lb-<node>) for bastion METALLB_PEERS matrix.
# Requires MetalLB (or cloud LB). Default no.
# APPLY_LOADBALANCER=yes

# Optional: apps domain for route hosts (OpenShift); if empty, routes get default host
# ROUTE_HOST_BASE=apps.cluster.example.com
