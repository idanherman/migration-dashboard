# Example environment configuration for bastion-client.py
# Copy this file and set values for your environment
# Shell usage:  cd source/bastion-peer && set -a && source config.env && set +a && python bastion-client.py
#
# Podman --env-file: do NOT use this file as-is (the "export " prefix breaks Podman: it
# creates variables named "export NODE_STATUS_ENDPOINTS", so Python never sees them).
# Use config.podman.example.env instead (KEY=value lines only).

# --- Primary (DaemonSet model): per-node endpoints ---
# One URL per node via NodePort (externalTrafficPolicy: Local). Generated by scripts/deploy.sh.
export NODE_STATUS_ENDPOINTS="http://node1-ip:30082,http://node2-ip:30082,http://node3-ip:30082"

# Optional: per-node URLs via OpenShift Route (for router connectivity test). Generated by deploy.sh.
export ROUTE_STATUS_ENDPOINTS="http://migration-peer-node1-ns.apps.cluster.example.com,http://..."
# Set to false to skip SSL verification for HTTPS endpoints (e.g. OpenShift self-signed cert)
export SSL_VERIFY=true

# --- Legacy / optional: external tests (MetalLB, NodePort, Routes) ---
# MetalLB LoadBalancer IPs (JSON format)
export METALLB_PEERS='{}'

# NodePort configuration (JSON format) - legacy multi-port per peer
export NODEPORT_PEERS='{}'

# HTTP Routes (comma-separated) - legacy
export ROUTE_PEERS=""

# --- Intervals and timeouts (seconds) ---
export HTTP_INTERVAL=1.0
export WS_INTERVAL=0.5
export TCP_INTERVAL=0.5
export POLL_INTERVAL=1.0
export RECONNECT_DELAY=1.0
export HTTP_TIMEOUT=1.0
export WS_OPEN_TIMEOUT=1.0
export TCP_CONNECT_TIMEOUT=1.0

# --- Dashboard ---
export DASHBOARD_PORT=9091
export MAX_HISTORY=200
