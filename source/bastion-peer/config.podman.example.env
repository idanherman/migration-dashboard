# Same variables as config.example.env, but KEY=value only (no "export" prefix).
# Required for: podman run ... --env-file ...
#
# Podman treats a line like "export FOO=bar" as variable name literally "export FOO",
# so bastion-client.py never sees FOO and uses wrong defaults.
#
# Copy to config.podman.env, fill from deploy.sh / print-expected-bastion-endpoints.sh output.

NODE_STATUS_ENDPOINTS=http://node1-ip:30082,http://node2-ip:30082,http://node3-ip:30082
ROUTE_STATUS_ENDPOINTS=http://migration-peer-node1-ns.apps.cluster.example.com,http://...
SSL_VERIFY=false

METALLB_PEERS={}
NODEPORT_PEERS={}
ROUTE_PEERS=

HTTP_INTERVAL=1.0
WS_INTERVAL=0.5
TCP_INTERVAL=0.5
POLL_INTERVAL=1.0
RECONNECT_DELAY=1.0
HTTP_TIMEOUT=1.0
WS_OPEN_TIMEOUT=1.0
TCP_CONNECT_TIMEOUT=1.0

DASHBOARD_PORT=9091
MAX_HISTORY=200
