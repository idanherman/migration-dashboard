{
  "name": "poc-plugin",
  "version": "0.0.1",
  "description": "Minimal OpenShift Console dynamic plugin proof of concept",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && NODE_ENV=production webpack",
    "build-dev": "npm run clean && webpack",
    "start": "webpack serve --progress",
    "start-console": "./start-console.sh"
  },
  "devDependencies": {
    "@openshift-console/dynamic-plugin-sdk": "1.2.0",
    "@openshift-console/dynamic-plugin-sdk-webpack": "1.1.0",
    "@types/node": "^18.19.0",
    "@types/react": "^17.0.37",
    "copy-webpack-plugin": "^6.4.1",
    "css-loader": "^6.7.1",
    "react": "^17.0.1",
    "style-loader": "^3.3.1",
    "ts-loader": "^9.3.1",
    "typescript": "^4.7.4",
    "webpack": "5.75.0",
    "webpack-cli": "^4.9.2",
    "webpack-dev-server": "^4.7.4"
  },
  "overrides": {
    "webpack": "5.75.0"
  },
  "consolePlugin": {
    "name": "poc-plugin",
    "version": "0.0.1",
    "displayName": "POC Console Plugin",
    "description": "Generic proof that a customer can load a custom page into the OpenShift web console.",
    "exposedModules": {
      "PocPage": "./components/PocPage"
    },
    "dependencies": {
      "@console/pluginAPI": "*"
    }
  }
}
